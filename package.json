{
  "name": "rs-x",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "rs-x-core",
    "rs-x-state-manager",
    "rs-x-expression-parser",
    "rs-x-compiler",
    "rs-x-typescript-plugin",
    "rs-x-vscode-extension",
    "rs-x-cli",
    "rs-x-angular/projects/rsx",
    "rs-x-react",
    "rs-x-vue",
    "rs-x-react-components",
    "rs-x-dev-tools",
    "rs-x-expression-editor",
    "rs-x-site",
    "rs-x-ui"
  ],
  "scripts": {
    "build:libs": "pnpm --filter '@rs-x/core' run build && pnpm --filter '@rs-x/state-manager' run build && pnpm --filter '@rs-x/expression-parser' run build && pnpm --filter '@rs-x/compiler' run build && pnpm --filter '@rs-x/react' run build && pnpm --filter '@rs-x/vue' run build",
    "build:angular": "pnpm --prefix rs-x-angular run build:angular",
    "clean": "pnpm -r exec rimraf node_modules dist && pnpm exec rimraf node_modules dist .pnpm-store",
    "reinstall": "pnpm run clean && pnpm install",
    "build:core": "pnpm --filter @rs-x/core run build",
    "build:state-manager": "pnpm --filter @rs-x/state-manager run build",
    "build:expression-parser": "pnpm --filter @rs-x/expression-parser run build",
    "build:compiler": "pnpm --filter @rs-x/compiler run build",
    "build:ts-plugin": "pnpm --filter @rs-x/typescript-plugin run build",
    "build:vscode-extension": "pnpm --filter rs-x-vscode-extension run build",
    "package:vscode-extension": "pnpm --filter rs-x-vscode-extension run package",
    "install:vscode-extension": "node ./rs-x-cli/bin/rsx.cjs install vscode --local",
    "cli:install:global": "./scripts/install-local-cli.sh",
    "cli:install:global:dry-run": "./scripts/install-local-cli.sh --dry-run",
    "test:a11y": "pnpm --filter @rs-x/site run test:a11y",
    "test:a11y:report": "pnpm --filter @rs-x/site run test:a11y:report",
    "verify:cli-mutations": "zsh ./rs-x-cli/scripts/verify-rsx-cli-mutations.sh",
    "verify:project-smoke": "zsh ./rs-x-cli/scripts/verify-rsx-projects.sh",
    "verify:setup-smoke": "zsh ./rs-x-cli/scripts/verify-rsx-setup.sh",
    "install:compiler-tooling": "pnpm run build:expression-parser && pnpm run build:compiler && pnpm run build:ts-plugin",
    "init:rsx": "node ./rs-x-cli/bin/rsx.cjs init --local",
    "setup:developer-tooling": "pnpm run install:compiler-tooling && pnpm run install:vscode-extension",
    "build:react": "pnpm --filter @rs-x/react run build",
    "build:vue": "pnpm --filter @rs-x/vue run build",
    "build:react-components": "pnpm --filter @rs-x/react-components run build",
    "build:devtools": "pnpm --filter @rs-x/dev-tools run build",
    "build:expression-editor": "pnpm --filter @rs-x/expression-editor run build",
    "typecheck:rsx": "node ./rs-x-cli/bin/rsx.cjs typecheck --project tsconfig.json",
    "test": "cross-env TZ=UTC pnpm jest --runInBand --no-cache --config jest.config.ts",
    "test:performance": "cross-env TZ=UTC RSX_INCLUDE_PERFORMANCE_TESTS=true pnpm jest --runInBand --no-cache --config jest.config.ts rs-x-expression-parser/tests/performance",
    "test:compiled-expression": "cross-env TZ=UTC NODE_OPTIONS='--max-old-space-size=4096' pnpm jest --runInBand --no-cache --config jest.config.ts rs-x-expression-parser/tests/compiled-expression",
    "test:compiled-expression:per-file": "cross-env TZ=UTC NODE_OPTIONS='--max-old-space-size=4096' bash scripts/test-compiled-expression-per-file.sh",
    "test:angular": "pnpm --prefix rs-x-angular run test",
    "test:react": "pnpm --prefix rs-x-react run test",
    "test:vue": "pnpm --filter @rs-x/vue run test",
    "test:coverage": "cross-env TZ=UTC pnpm jest --coverage",
    "test:strict": "pnpm typecheck:rsx && cross-env TZ=UTC pnpm jest --runInBand --no-cache --config jest.config.ts",
    "ci:build": "pnpm -w run format:check && pnpm -w run lint && pnpm -w run build:libs && pnpm -w run build:compiler && pnpm -w run build:ts-plugin && pnpm -w run build:vscode-extension && pnpm --filter @rs-x/cli run build && pnpm -w run build:expression-editor && pnpm -w run build:angular && pnpm --filter @rs-x/react-components run build && pnpm --filter @rs-x/site run build && pnpm -w run test && pnpm -w run test:angular && pnpm -w run test:react && pnpm -w run test:vue",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix"
  },
  "devDependencies": {
    "@angular/common": "21.2.7",
    "@angular/compiler": "21.2.7",
    "@angular/compiler-cli": "21.2.7",
    "@angular/core": "21.2.7",
    "@angular/platform-browser-dynamic": "21.2.7",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@changesets/cli": "^2.30.0",
    "@microsoft/api-extractor": "^7.58.1",
    "@monaco-editor/react": "^4.7.0",
    "@rs-x/compiler": "workspace:*",
    "@rs-x/core": "workspace:*",
    "@rs-x/expression-parser": "workspace:*",
    "@rs-x/state-manager": "workspace:*",
    "@swc/core": "^1.15.24",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.1.39",
    "@types/espree": "11.1.0",
    "@types/jest": "^30.0.0",
    "@types/lodash.clonedeepwith": "^4.5.9",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@ungap/structured-clone": "^1.3.0",
    "@vitest/coverage-v8": "4.1.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-mock-extended": "^4.0.0",
    "jest-transform-stub": "^2.0.0",
    "jsdom": "^29.0.2",
    "ng-packagr": "^21.2.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-resizable-panels": "^4.9.0",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.3",
    "vue": "^3.5.32",
    "zone.js": "0.16.1"
  },
  "dependencies": {
    "dedent": "^1.7.2",
    "next": "^16.2.2",
    "react-icons": "^5.6.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "tsup@8.5.1": "patches/tsup@8.5.1.patch",
      "ng-packagr@21.2.2": "patches/ng-packagr@21.2.2.patch"
    },
    "overrides": {
      "typescript": "^6.0.2",
      "@angular/core": "21.2.7",
      "@angular/common": "21.2.7",
      "@angular/compiler": "21.2.7",
      "@angular/compiler-cli": "21.2.7",
      "@angular/platform-browser": "21.2.7",
      "@angular/platform-browser-dynamic": "21.2.7",
      "zone.js": "0.16.1"
    }
  }
}
