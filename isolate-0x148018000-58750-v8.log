script-source,86,file:///Users/robertsanders/projects/rs-x/rs-x-expression-parser/tmp-perf-profile.mjs,import { performance } from 'node:perf_hooks';\nimport { InjectionContainer } from '@rs-x/core';\nimport { RsXExpressionParserModule\x2C rsx } from '@rs-x/expression-parser';\n\nawait InjectionContainer.load(RsXExpressionParserModule);\n\nconst N = 5000;\nconst models = Array.from({ length: N }\x2C (_\x2C i) => ({ [`f${i}`]: i }));\nconst exprs  = Array.from({ length: N }\x2C (_\x2C i) => `f${i}`);\n\n// Warm up so JIT is hot\nexprs.forEach(e => rsx(e));\n{ const b = models.map((m\x2Ci) => rsx(exprs[i])(m)); b.forEach(x=>x.dispose()); }\nif (typeof global.gc === 'function') global.gc();\n\n// Profile this section\nconst t0 = performance.now();\nconst bindings = models.map((m\x2Ci) => rsx(exprs[i])(m));\nconsole.log(`bind: ${(performance.now()-t0).toFixed(2)}ms`);\n
