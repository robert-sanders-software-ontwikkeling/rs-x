{
  "name": "@rs-x/vue",
  "version": "1.0.2",
  "description": "Vue extension for the RS-X framework with composables to bind RS-X expressions to Vue components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/robert-sanders-software-ontwikkeling/rs-x"
  },
  "homepage": "https://github.com/robert-sanders-software-ontwikkeling/rs-x",
  "bugs": {
    "url": "https://github.com/robert-sanders-software-ontwikkeling/rs-x/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external vue --tsconfig ../tsconfig.build.json",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "dependencies": {
    "@rs-x/core": "workspace:*",
    "@rs-x/expression-parser": "workspace:*",
    "@rs-x/state-manager": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^10.0.1",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^17.3.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vue-eslint-parser": "^10.2.0",
    "vitest": "^4.0.18",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "rs-x",
    "vue",
    "reactive",
    "expressions",
    "typescript",
    "composable"
  ]
}
