{
  "name": "@rs-x/core",
  "version": "2.0.0",
  "description": "Core reactive primitives, dependency injection, and state foundations for the RS-X framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/robert-sanders-software-ontwikkeling/rs-x"
  },
  "homepage": "https://github.com/robert-sanders-software-ontwikkeling/rs-x",
  "bugs": {
    "url": "https://github.com/robert-sanders-software-ontwikkeling/rs-x/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup lib/index.ts --format esm --dts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "fast-equals": "^6.0.0",
    "inversify": "^8.1.0",
    "reflect-metadata": "^0.2.2"
  },
  "peerDependencies": {
    "rxjs": "^7.8.2"
  },
  "peerDependenciesMeta": {
    "rxjs": {
      "optional": false
    }
  },
  "devDependencies": {
    "globals": "^17.4.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "rs-x",
    "reactive",
    "state-management",
    "dependency-injection",
    "observable",
    "typescript",
    "framework-core"
  ]
}
