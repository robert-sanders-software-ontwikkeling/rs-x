{
  "exportall.config.relExclusion": [
    "/rs-x-core/lib/testing",
    "/rs-x-state-manager/lib/testing",
    "/rs-x-react/src/__tests__",
    "/rs-x-expression-parser/lib/benchmark"
  ],
  "jest.nodeEnv": {
    "TZ": "UTC"
  },
  "jest.jestCommandLine": "pnpm jest --config jest.config.ts",
  "jest.monitorLongRun": 180000,
  "typescript.updateImportsOnFileMove.enabled": "never",
  "[typescript]": {
    "editor.codeActionsOnSave": {
      "source.organizeImports": "never",
      "source.fixAll.eslint": "always"
    }
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports": "never",
    "source.fixAll.eslint": "always"
  },
}
