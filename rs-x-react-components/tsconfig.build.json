{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "typeRoots": ["../node_modules/@types"],
    "emitDecoratorMetadata": false,
    "paths": {
      "@rs-x/compiler": ["../rs-x-compiler/dist/index.d.ts"],
      "@rs-x/react": ["../rs-x-react/dist/index.d.ts"],
      "@rs-x/vue": ["../rs-x-vue/dist/index.d.ts"],
      "@rs-x/angular": ["../rs-x-angular/dist/rsx/types/rs-x-angular.d.ts"]
    }
  },
  "include": ["src/**/*", "../types/declarations.d.ts"]
}
