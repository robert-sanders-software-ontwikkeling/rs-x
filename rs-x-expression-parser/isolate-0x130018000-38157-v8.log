script-source,85,file:///Users/robertsanders/projects/rs-x/rs-x-expression-parser/scripts/benchmark-core-concepts-performance.mjs,import fs from 'node:fs/promises';\nimport os from 'node:os';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { performance } from 'node:perf_hooks';\n\nimport { InjectionContainer } from '@rs-x/core';\nimport {\n  RsXExpressionParserInjectionTokens\x2C\n  RsXExpressionParserModule\x2C\n  rsx\x2C\n} from '@rs-x/expression-parser';\nimport { RsXStateManagerInjectionTokens } from '@rs-x/state-manager';\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\nconst repoRoot = path.resolve(__dirname\x2C '..'\x2C '..');\nconst reportsDirectory = path.resolve(\n  repoRoot\x2C\n  'reports'\x2C\n  'rsx-core-concepts-performance'\x2C\n);\nconst dateStamp = new Date().toISOString().slice(0\x2C 10);\n\nconst parseTermCounts = [1\x2C 2\x2C 4\x2C 8\x2C 16\x2C 32];\nconst bindingCounts = [1000\x2C 3000\x2C 5000\x2C 10000];\n\nconst runs = {\n  parse: 7\x2C\n  bind: 5\x2C\n  updateSingle: 30\x2C\n  updateBulk: 10\x2C\n};\n\nconst warmups = {\n  parse: 1\x2C\n  bind: 1\x2C\n  updateSingle: 3\x2C\n  updateBulk: 2\x2C\n};\n\nconst parseIterations = 5000;\nconst totalMemoryGb = os.totalmem() / (1024 * 1024 * 1024);\nconst cpuModel = os.cpus()[0]?.model ?? 'unknown';\nconst MB = 1024 * 1024;\n\nconst getBindingRuns = (count) => {\n  if (count >= 10_000) {\n    return {\n      bind: 3\x2C\n      updateSingle: 12\x2C\n      updateBulk: 5\x2C\n      warmupBind: 1\x2C\n      warmupUpdateSingle: 2\x2C\n      warmupUpdateBulk: 1\x2C\n    };\n  }\n\n  if (count >= 5_000) {\n    return {\n      bind: 4\x2C\n      updateSingle: 20\x2C\n      updateBulk: 8\x2C\n      warmupBind: 1\x2C\n      warmupUpdateSingle: 2\x2C\n      warmupUpdateBulk: 2\x2C\n    };\n  }\n\n  return {\n    bind: runs.bind\x2C\n    updateSingle: runs.updateSingle\x2C\n    updateBulk: runs.updateBulk\x2C\n    warmupBind: warmups.bind\x2C\n    warmupUpdateSingle: warmups.updateSingle\x2C\n    warmupUpdateBulk: warmups.updateBulk\x2C\n  };\n};\n\nconst median = (values) => {\n  const sorted = [...values].sort((a\x2C b) => a - b);\n  const middle = Math.floor(sorted.length / 2);\n  if (sorted.length % 2 === 0) {\n    return (sorted[middle - 1] + sorted[middle]) / 2;\n  }\n  return sorted[middle];\n};\n\nconst percentile = (values\x2C p) => {\n  if (values.length === 0) {\n    return 0;\n  }\n\n  const sorted = [...values].sort((a\x2C b) => a - b);\n  const index = Math.floor((sorted.length - 1) * p);\n  return sorted[index];\n};\n\nconst summarize = (samples) => ({\n  samples\x2C\n  minMs: Math.min(...samples)\x2C\n  maxMs: Math.max(...samples)\x2C\n  medianMs: median(samples)\x2C\n  p95Ms: percentile(samples\x2C 0.95)\x2C\n  avgMs: samples.reduce((sum\x2C value) => sum + value\x2C 0) / samples.length\x2C\n});\n\nconst summarizeMb = (samples) => ({\n  minMb: Math.min(...samples)\x2C\n  maxMb: Math.max(...samples)\x2C\n  medianMb: median(samples)\x2C\n  p95Mb: percentile(samples\x2C 0.95)\x2C\n  avgMb: samples.reduce((sum\x2C value) => sum + value\x2C 0) / samples.length\x2C\n});\n\nconst formatMs = (value) => `${value.toFixed(3)} ms`;\n\nconst makeModelForTerms = (termCount) => {\n  const model = {};\n  for (let i = 0; i < termCount; i += 1) {\n    model[`v${i}`] = i + 1;\n  }\n  return model;\n};\n\nconst makeExpressionForTerms = (termCount) => {\n  if (termCount === 1) {\n    return 'v0';\n  }\n\n  const terms = [];\n  for (let i = 0; i < termCount; i += 1) {\n    terms.push(`v${i}`);\n  }\n  return terms.join(' + ');\n};\n\nconst makeExpressionForTermsWithSeed = (termCount\x2C seed) => {\n  if (termCount === 1) {\n    return `v0_${seed}`;\n  }\n\n  const terms = [];\n  for (let i = 0; i < termCount; i += 1) {\n    terms.push(`v${i}_${seed}`);\n  }\n  return terms.join(' + ');\n};\n\nconst makeUniqueExpressions = (count) =>\n  Array.from({ length: count }\x2C (_\x2C i) => `x${i} + y${i}`);\n\nconst makeWideModel = (count) => {\n  const model = {};\n  for (let i = 0; i < count; i += 1) {\n    model[`x${i}`] = i;\n    model[`y${i}`] = i * 2;\n  }\n  return model;\n};\n\nconst makeRowModels = (count) =>\n  Array.from({ length: count }\x2C (_\x2C i) => ({ a: i\x2C b: i * 2 }));\n\nconst countNodes = (expression) => {\n  const children = expression.childExpressions ?? [];\n  let total = 1;\n  for (let i = 0; i < children.length; i += 1) {\n    total += countNodes(children[i]);\n  }\n  return total;\n};\n\nconst flushMicrotasks = async (rounds = 3) => {\n  for (let i = 0; i < rounds; i += 1) {\n    await Promise.resolve();\n  }\n};\n\nconst waitForExpressionsInitialized = async (expressions\x2C maxPolls = 2000) => {\n  let polls = 0;\n  while (expressions.some((expression) => expression.value === undefined)) {\n    await flushMicrotasks(1);\n    polls += 1;\n    if (polls >= maxPolls) {\n      throw new Error('Timed out waiting for expressions to initialize');\n    }\n  }\n};\n\nconst runTimer = async (runCount\x2C warmupCount\x2C action) => {\n  for (let i = 0; i < warmupCount; i += 1) {\n    await action();\n  }\n\n  const durationSamples = [];\n  const rssAfterSamples = [];\n  const heapAfterSamples = [];\n  const rssDeltaSamples = [];\n  const heapDeltaSamples = [];\n  for (let i = 0; i < runCount; i += 1) {\n    if (typeof global.gc === 'function') {\n      global.gc();\n    }\n    const memoryBefore = process.memoryUsage();\n    const started = performance.now();\n\n    await action();\n    const ended = performance.now();\n    await flushMicrotasks(1);\n    const memoryAfter = process.memoryUsage();\n\n    durationSamples.push(ended - started);\n    rssAfterSamples.push(memoryAfter.rss / MB);\n    heapAfterSamples.push(memoryAfter.heapUsed / MB);\n    rssDeltaSamples.push((memoryAfter.rss - memoryBefore.rss) / MB);\n    heapDeltaSamples.push((memoryAfter.heapUsed - memoryBefore.heapUsed) / MB);\n  }\n\n  return {\n    ...summarize(durationSamples)\x2C\n    memory: {\n      rssAfterMb: summarizeMb(rssAfterSamples)\x2C\n      heapAfterMb: summarizeMb(heapAfterSamples)\x2C\n      rssDeltaMb: summarizeMb(rssDeltaSamples)\x2C\n      heapDeltaMb: summarizeMb(heapDeltaSamples)\x2C\n    }\x2C\n  };\n};\n\nawait InjectionContainer.load(RsXExpressionParserModule);\nconst expressionParser = InjectionContainer.get(\n  RsXExpressionParserInjectionTokens.IExpressionParser\x2C\n);\nconst expressionCache = InjectionContainer.get(\n  RsXExpressionParserInjectionTokens.IExpressionCache\x2C\n);\nconst stateManager = InjectionContainer.get(\n  RsXStateManagerInjectionTokens.IStateManager\x2C\n);\n\nconst resetRuntimeState = async () => {\n  stateManager.clear();\n  expressionCache.dispose();\n  await flushMicrotasks();\n  if (typeof global.gc === 'function') {\n    global.gc();\n  }\n};\n\nconst results = {\n  generatedAt: new Date().toISOString()\x2C\n  environment: {\n    nodeVersion: process.version\x2C\n    platform: process.platform\x2C\n    arch: process.arch\x2C\n    osRelease: os.release()\x2C\n    cpuModel\x2C\n    totalMemoryGb: Number(totalMemoryGb.toFixed(1))\x2C\n    rssMb: Math.round(process.memoryUsage().rss / (1024 * 1024))\x2C\n  }\x2C\n  config: {\n    parseTermCounts\x2C\n    bindingCounts\x2C\n    runs\x2C\n    warmups\x2C\n    parseIterations\x2C\n    bindingRunOverrides: {\n      5000: {\n        bind: 4\x2C\n        updateSingle: 20\x2C\n        updateBulk: 8\x2C\n      }\x2C\n      10000: {\n        bind: 3\x2C\n        updateSingle: 12\x2C\n        updateBulk: 5\x2C\n      }\x2C\n    }\x2C\n  }\x2C\n  sections: {\n    parseByNodeCount: []\x2C\n    parseCacheByNodeCount: []\x2C\n    bindingScale: []\x2C\n    bindingScaleInitialized: []\x2C\n  }\x2C\n};\n\nconsole.log('rs-x core-concepts performance benchmark');\nconsole.log(`Node ${process.version}`);\n\nconsole.log('\\nParse by node count');\nfor (const termCount of parseTermCounts) {\n  const expression = makeExpressionForTerms(termCount);\n  const parsedForNodeCount = expressionParser.parse(expression);\n  const nodeCount = countNodes(parsedForNodeCount);\n\n  const stats = await runTimer(runs.parse\x2C warmups.parse\x2C async () => {\n    for (let i = 0; i < parseIterations; i += 1) {\n      expressionParser.parse(expression);\n    }\n  });\n\n  const usPerOperation = (stats.medianMs * 1000) / parseIterations;\n  const opsPerSecond = (parseIterations / stats.medianMs) * 1000;\n\n  results.sections.parseByNodeCount.push({\n    termCount\x2C\n    nodeCount\x2C\n    expression\x2C\n    parseIterations\x2C\n    ...stats\x2C\n    usPerOperation\x2C\n    opsPerSecond\x2C\n  });\n\n  console.log(\n    `nodes ${nodeCount.toLocaleString()}: median ${formatMs(stats.medianMs)} (${opsPerSecond.toFixed(0)} ops/s)`\x2C\n  );\n}\n\nconsole.log('\\nParse cache behavior (parse+clone vs clone-only)');\nfor (const termCount of parseTermCounts) {\n  const expression = makeExpressionForTerms(termCount);\n  const parsedForNodeCount = expressionParser.parse(expression);\n  const nodeCount = countNodes(parsedForNodeCount);\n\n  await resetRuntimeState();\n\n  let uniqueSeed = 0;\n  const parseAndCloneStats = await runTimer(\n    runs.parse\x2C\n    warmups.parse\x2C\n    async () => {\n      for (let i = 0; i < parseIterations; i += 1) {\n        uniqueSeed += 1;\n        const uniqueExpression = makeExpressionForTermsWithSeed(\n          termCount\x2C\n          uniqueSeed\x2C\n        );\n        const result = expressionCache.create(uniqueExpression);\n        result.instance.dispose();\n        expressionCache.release(result.id);\n      }\n    }\x2C\n  );\n\n  await resetRuntimeState();\n\n  const pinnedExpression = makeExpressionForTermsWithSeed(termCount\x2C 999999);\n  const pinned = expressionCache.create(pinnedExpression);\n  pinned.instance.dispose();\n\n  const cloneOnlyStats = await runTimer(runs.parse\x2C warmups.parse\x2C async () => {\n    for (let i = 0; i < parseIterations; i += 1) {\n      const result = expressionCache.create(pinnedExpression);\n      result.instance.dispose();\n      expressionCache.release(result.id);\n    }\n  });\n\n  expressionCache.release(pinned.id);\n  await resetRuntimeState();\n\n  results.sections.parseCacheByNodeCount.push({\n    termCount\x2C\n    nodeCount\x2C\n    expression\x2C\n    parseIterations\x2C\n    parseAndClone: {\n      ...parseAndCloneStats\x2C\n      usPerOperation: (parseAndCloneStats.medianMs * 1000) / parseIterations\x2C\n      opsPerSecond: (parseIterations / parseAndCloneStats.medianMs) * 1000\x2C\n    }\x2C\n    cloneOnly: {\n      ...cloneOnlyStats\x2C\n      usPerOperation: (cloneOnlyStats.medianMs * 1000) / parseIterations\x2C\n      opsPerSecond: (parseIterations / cloneOnlyStats.medianMs) * 1000\x2C\n    }\x2C\n  });\n\n  console.log(\n    `nodes ${nodeCount.toLocaleString()}: parse+clone ${formatMs(parseAndCloneStats.medianMs)}\x2C clone-only ${formatMs(cloneOnlyStats.medianMs)}`\x2C\n  );\n}\n\nconsole.log('\\nBinding scale');\nfor (const count of bindingCounts) {\n  const bindingRuns = getBindingRuns(count);\n  const uniqueExpressions = makeUniqueExpressions(count);\n  const wideModel = makeWideModel(count);\n  const rowModels = makeRowModels(count);\n\n  await resetRuntimeState();\n\n  const bindUniqueStats = await runTimer(\n    bindingRuns.bind\x2C\n    bindingRuns.warmupBind\x2C\n    async () => {\n      const expressions = [];\n      for (let i = 0; i < uniqueExpressions.length; i += 1) {\n        expressions.push(rsx(uniqueExpressions[i])(wideModel));\n      }\n      for (const expression of expressions) {\n        expression.dispose();\n      }\n    }\x2C\n  );\n\n  await resetRuntimeState();\n\n  const bindSameStats = await runTimer(\n    bindingRuns.bind\x2C\n    bindingRuns.warmupBind\x2C\n    async () => {\n      const expressions = [];\n      for (let i = 0; i < rowModels.length; i += 1) {\n        expressions.push(rsx('a + b')(rowModels[i]));\n      }\n      for (const expression of expressions) {\n        expression.dispose();\n      }\n    }\x2C\n  );\n\n  await resetRuntimeState();\n\n  const bindUniqueInitializedStats = await runTimer(\n    bindingRuns.bind\x2C\n    bindingRuns.warmupBind\x2C\n    async () => {\n      const expressions = [];\n      for (let i = 0; i < uniqueExpressions.length; i += 1) {\n        expressions.push(rsx(uniqueExpressions[i])(wideModel));\n      }\n      await waitForExpressionsInitialized(expressions);\n      for (const expression of expressions) {\n        expression.dispose();\n      }\n    }\x2C\n  );\n\n  await resetRuntimeState();\n\n  const bindSameInitializedStats = await runTimer(\n    bindingRuns.bind\x2C\n    bindingRuns.warmupBind\x2C\n    async () => {\n      const expressions = [];\n      for (let i = 0; i < rowModels.length; i += 1) {\n        expressions.push(rsx('a + b')(rowModels[i]));\n      }\n      await waitForExpressionsInitialized(expressions);\n      for (const expression of expressions) {\n        expression.dispose();\n      }\n    }\x2C\n  );\n\n  await resetRuntimeState();\n\n  const updateExpressions = rowModels.map((row) => rsx('a + b')(row));\n\n  const updateSingleStats = await runTimer(\n    bindingRuns.updateSingle\x2C\n    bindingRuns.warmupUpdateSingle\x2C\n    async () => {\n      const index = Math.floor(count / 2);\n      rowModels[index].a += 1;\n      await flushMicrotasks();\n    }\x2C\n  );\n\n  const updateBulkStats = await runTimer(\n    bindingRuns.updateBulk\x2C\n    bindingRuns.warmupUpdateBulk\x2C\n    async () => {\n      for (let i = 0; i < rowModels.length; i += 1) {\n        rowModels[i].a += 1;\n      }\n      await flushMicrotasks();\n    }\x2C\n  );\n\n  for (const expression of updateExpressions) {\n    expression.dispose();\n  }\n  await resetRuntimeState();\n\n  results.sections.bindingScale.push({\n    bindings: count\x2C\n    bindUnique: {\n      ...bindUniqueStats\x2C\n      usPerBinding: (bindUniqueStats.medianMs * 1000) / count\x2C\n      bindingsPerSecond: (count / bindUniqueStats.medianMs) * 1000\x2C\n    }\x2C\n    bindSameExpressionAgain: {\n      ...bindSameStats\x2C\n      usPerBinding: (bindSameStats.medianMs * 1000) / count\x2C\n      bindingsPerSecond: (count / bindSameStats.medianMs) * 1000\x2C\n    }\x2C\n    updateSingleActiveBinding: {\n      ...updateSingleStats\x2C\n    }\x2C\n    updateBulkActiveBindings: {\n      ...updateBulkStats\x2C\n      usPerBinding: (updateBulkStats.medianMs * 1000) / count\x2C\n      bindingsPerSecond: (count / updateBulkStats.medianMs) * 1000\x2C\n    }\x2C\n  });\n\n  results.sections.bindingScaleInitialized.push({\n    bindings: count\x2C\n    bindUnique: {\n      ...bindUniqueInitializedStats\x2C\n      usPerBinding: (bindUniqueInitializedStats.medianMs * 1000) / count\x2C\n      bindingsPerSecond: (count / bindUniqueInitializedStats.medianMs) * 1000\x2C\n    }\x2C\n    bindSameExpressionAgain: {\n      ...bindSameInitializedStats\x2C\n      usPerBinding: (bindSameInitializedStats.medianMs * 1000) / count\x2C\n      bindingsPerSecond:\n        (count / bindSameInitializedStats.medianMs) * 1000\x2C\n    }\x2C\n  });\n\n  console.log(\n    `bindings ${count.toLocaleString()}: bind unique ${formatMs(bindUniqueStats.medianMs)}\x2C bind same ${formatMs(bindSameStats.medianMs)}\x2C bind+init unique ${formatMs(bindUniqueInitializedStats.medianMs)}\x2C bind+init same ${formatMs(bindSameInitializedStats.medianMs)}\x2C single update ${formatMs(updateSingleStats.medianMs)}\x2C bulk update ${formatMs(updateBulkStats.medianMs)}`\x2C\n  );\n}\n\nawait fs.mkdir(reportsDirectory\x2C { recursive: true });\n\nconst jsonOutputPath = path.resolve(\n  reportsDirectory\x2C\n  `benchmark-${dateStamp}.json`\x2C\n);\nawait fs.writeFile(\n  jsonOutputPath\x2C\n  `${JSON.stringify(results\x2C null\x2C 2)}\\n`\x2C\n  'utf-8'\x2C\n);\n\nconst markdownLines = [\n  '# rs-x core concepts performance benchmark'\x2C\n  ''\x2C\n  `Generated at: ${results.generatedAt}`\x2C\n  `Machine: ${results.environment.cpuModel}\x2C ${results.environment.totalMemoryGb.toFixed(1)} GB RAM\x2C ${results.environment.platform}/${results.environment.arch}\x2C OS ${results.environment.osRelease}`\x2C\n  `Node: ${results.environment.nodeVersion}`\x2C\n  ''\x2C\n  '## How to read this report'\x2C\n  ''\x2C\n  '- Parse by node count: how long it takes to read an expression string and build the internal expression tree.'\x2C\n  '- Parse cache behavior: the first time an expression string appears\x2C rs-x parses it and stores a cached template tree. When the same string is used again\x2C rs-x skips parsing and clones that cached template.'\x2C\n  '- Binding performance: first-time setup cost when an expression is attached to a model and its first value is computed.'\x2C\n  '- Update performance: cost after setup when data changes; only affected bound expressions are recalculated.'\x2C\n  '- In this benchmark\x2C each bound row expression is `a + b`.'\x2C\n  '- `Single update` changes one row (`a` for one bound expression)\x2C so only that row expression is recalculated.'\x2C\n  '- `Bulk update` changes every row (`a` for all bound expressions)\x2C so each bound row expression is recalculated once.'\x2C\n  '- Memory usage: `Median heap` is typical JS heap after a run; `Peak RSS` is highest process memory while running.'\x2C\n  `- Parse scenarios execute ${parseIterations.toLocaleString()} parse/create operations per sample and do not bind to models.`\x2C\n  '- Binding/update scenarios use the exact binding count shown in each row.'\x2C\n  ''\x2C\n  '## Comparison guidance'\x2C\n  ''\x2C\n  '- Compare runs only when machine\x2C Node version\x2C and benchmark script are the same.'\x2C\n  '- Prefer medians over min/max to avoid overreacting to GC and scheduler noise.'\x2C\n  '- For release notes\x2C validate changes with repeated runs and track the median trend.'\x2C\n  ''\x2C\n  '## Parse by node count'\x2C\n  ''\x2C\n  '| Nodes | Expression | Median (ms) | us/op | ops/s |'\x2C\n  '| ---: | --- | ---: | ---: | ---: |'\x2C\n  ...results.sections.parseByNodeCount.map((row) => {\n    return `| ${row.nodeCount} | \\`${row.expression}\\` | ${row.medianMs.toFixed(3)} | ${row.usPerOperation.toFixed(2)} | ${row.opsPerSecond.toFixed(0)} |`;\n  })\x2C\n  ''\x2C\n  '## Parse cache behavior (parse+clone vs clone-only)'\x2C\n  ''\x2C\n  '| Nodes | Parse+clone median (ms) | Parse+clone us/op | Clone-only median (ms) | Clone-only us/op |'\x2C\n  '| ---: | ---: | ---: | ---: | ---: |'\x2C\n  ...results.sections.parseCacheByNodeCount.map((row) => {\n    return `| ${row.nodeCount} | ${row.parseAndClone.medianMs.toFixed(3)} | ${row.parseAndClone.usPerOperation.toFixed(2)} | ${row.cloneOnly.medianMs.toFixed(3)} | ${row.cloneOnly.usPerOperation.toFixed(2)} |`;\n  })\x2C\n  ''\x2C\n  '## Binding performance (initial full evaluation)'\x2C\n  ''\x2C\n  '| Bindings | Bind unique median (ms) | Bind same-expression median (ms) |'\x2C\n  '| ---: | ---: | ---: |'\x2C\n  ...results.sections.bindingScale.map((row) => {\n    return `| ${row.bindings.toLocaleString()} | ${row.bindUnique.medianMs.toFixed(3)} | ${row.bindSameExpressionAgain.medianMs.toFixed(3)} |`;\n  })\x2C\n  ''\x2C\n  '## Update performance (incremental reevaluation)'\x2C\n  ''\x2C\n  '| Bindings | Single update median (ms) | Bulk update median (ms) |'\x2C\n  '| ---: | ---: | ---: |'\x2C\n  ...results.sections.bindingScale.map((row) => {\n    return `| ${row.bindings.toLocaleString()} | ${row.updateSingleActiveBinding.medianMs.toFixed(3)} | ${row.updateBulkActiveBindings.medianMs.toFixed(3)} |`;\n  })\x2C\n  ''\x2C\n  '## Binding performance (bind + initialize)'\x2C\n  ''\x2C\n  '| Bindings | Bind+initialize unique median (ms) | Bind+initialize same-expression median (ms) |'\x2C\n  '| ---: | ---: | ---: |'\x2C\n  ...results.sections.bindingScaleInitialized.map((row) => {\n    return `| ${row.bindings.toLocaleString()} | ${row.bindUnique.medianMs.toFixed(3)} | ${row.bindSameExpressionAgain.medianMs.toFixed(3)} |`;\n  })\x2C\n  ''\x2C\n  '## Memory usage'\x2C\n  ''\x2C\n  '| Scenario | Median heap after run (MB) | Peak RSS after run (MB) |'\x2C\n  '| --- | ---: | ---: |'\x2C\n  ...results.sections.parseByNodeCount.map((row) => {\n    return `| Parse (${row.nodeCount} nodes) | ${row.memory.heapAfterMb.medianMb.toFixed(1)} | ${row.memory.rssAfterMb.maxMb.toFixed(1)} |`;\n  })\x2C\n  ...results.sections.bindingScale.flatMap((row) => {\n    return [\n      `| Bind unique (${row.bindings.toLocaleString()}) | ${row.bindUnique.memory.heapAfterMb.medianMb.toFixed(1)} | ${row.bindUnique.memory.rssAfterMb.maxMb.toFixed(1)} |`\x2C\n      `| Bind same expression (${row.bindings.toLocaleString()}) | ${row.bindSameExpressionAgain.memory.heapAfterMb.medianMb.toFixed(1)} | ${row.bindSameExpressionAgain.memory.rssAfterMb.maxMb.toFixed(1)} |`\x2C\n      `| Single update (${row.bindings.toLocaleString()}) | ${row.updateSingleActiveBinding.memory.heapAfterMb.medianMb.toFixed(1)} | ${row.updateSingleActiveBinding.memory.rssAfterMb.maxMb.toFixed(1)} |`\x2C\n      `| Bulk update (${row.bindings.toLocaleString()}) | ${row.updateBulkActiveBindings.memory.heapAfterMb.medianMb.toFixed(1)} | ${row.updateBulkActiveBindings.memory.rssAfterMb.maxMb.toFixed(1)} |`\x2C\n    ];\n  })\x2C\n  ...results.sections.bindingScaleInitialized.flatMap((row) => {\n    return [\n      `| Bind+initialize unique (${row.bindings.toLocaleString()}) | ${row.bindUnique.memory.heapAfterMb.medianMb.toFixed(1)} | ${row.bindUnique.memory.rssAfterMb.maxMb.toFixed(1)} |`\x2C\n      `| Bind+initialize same expression (${row.bindings.toLocaleString()}) | ${row.bindSameExpressionAgain.memory.heapAfterMb.medianMb.toFixed(1)} | ${row.bindSameExpressionAgain.memory.rssAfterMb.maxMb.toFixed(1)} |`\x2C\n    ];\n  })\x2C\n  ''\x2C\n].join('\\n');\n\nconst markdownOutputPath = path.resolve(\n  reportsDirectory\x2C\n  `benchmark-${dateStamp}.md`\x2C\n);\nawait fs.writeFile(markdownOutputPath\x2C `${markdownLines}\\n`\x2C 'utf-8');\n\nconsole.log(`\\nSaved benchmark JSON to: ${jsonOutputPath}`);\nconsole.log(`Saved benchmark Markdown to: ${markdownOutputPath}`);\n
