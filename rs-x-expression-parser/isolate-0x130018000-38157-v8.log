it the experimental warning.\n  const strippedSource = stripTypeScriptModuleTypes(source\x2C kEvalTag);\n  evalScript(name\x2C strippedSource\x2C breakFirstLine\x2C print\x2C shouldLoadESM);\n}\n\n/**\n *\n * @param {string} name - The filename of the script.\n * @param {string} body - The code of the script.\n * @param {string} baseUrl Path of the parent importing the module.\n * @returns {ContextifyScript} The created contextify script.\n */\nfunction compileScript(name\x2C body\x2C baseUrl) {\n  const hostDefinedOptionId = Symbol(name);\n  async function importModuleDynamically(specifier\x2C _\x2C importAttributes\x2C phase) {\n    const cascadedLoader = require('internal/modules/esm/loader').getOrInitializeCascadedLoader();\n    return cascadedLoader.import(specifier\x2C baseUrl\x2C importAttributes\x2C\n                                 phase === 'source' ? kSourcePhase : kEvaluationPhase);\n  }\n  return makeContextifyScript(\n    body\x2C                    // code\n    name\x2C                    // filename\x2C\n    0\x2C                       // lineOffset\n    0\x2C                       // columnOffset\x2C\n    undefined\x2C               // cachedData\n    false\x2C                   // produceCachedData\n    undefined\x2C               // parsingContext\n    hostDefinedOptionId\x2C     // hostDefinedOptionId\n    importModuleDynamically\x2C // importModuleDynamically\n  );\n}\n\n/**\n * @param {string} name - The filename of the script.\n * @param {string} body - The code of the script.\n * @returns {boolean} Whether the module entry point should be evaluated as a module.\n */\nfunction shouldUseModuleEntryPoint(name\x2C body) {\n  return getOptionValue('--experimental-detect-module') &&\n    getOptionValue('--input-type') === '' &&\n    containsModuleSyntax(body\x2C name\x2C null\x2C 'no CJS variables');\n}\n\n/**\n *\n * @param {string} name - The filename of the script.\n * @returns {import('internal/modules/esm/loader').CJSModule} The created module