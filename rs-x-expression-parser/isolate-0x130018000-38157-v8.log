script-source,124,file:///Users/robertsanders/projects/rs-x/node_modules/astring/dist/astring.mjs,// Astring is a tiny and fast JavaScript code generator from an ESTree-compliant AST.\n//\n// Astring was written by David Bonnet and released under an MIT license.\n//\n// The Git repository for Astring is available at:\n// https://github.com/davidbonnet/astring.git\n//\n// Please use the GitHub bug tracker to report issues:\n// https://github.com/davidbonnet/astring/issues\n\nconst { stringify } = JSON\n\n/* c8 ignore if */\nif (!String.prototype.repeat) {\n  /* c8 ignore next */\n  throw new Error(\n    'String.prototype.repeat is undefined\x2C see https://github.com/davidbonnet/astring#installation'\x2C\n  )\n}\n\n/* c8 ignore if */\nif (!String.prototype.endsWith) {\n  /* c8 ignore next */\n  throw new Error(\n    'String.prototype.endsWith is undefined\x2C see https://github.com/davidbonnet/astring#installation'\x2C\n  )\n}\n\nconst OPERATOR_PRECEDENCE = {\n  '||': 2\x2C\n  '??': 3\x2C\n  '&&': 4\x2C\n  '|': 5\x2C\n  '^': 6\x2C\n  '&': 7\x2C\n  '==': 8\x2C\n  '!=': 8\x2C\n  '===': 8\x2C\n  '!==': 8\x2C\n  '<': 9\x2C\n  '>': 9\x2C\n  '<=': 9\x2C\n  '>=': 9\x2C\n  in: 9\x2C\n  instanceof: 9\x2C\n  '<<': 10\x2C\n  '>>': 10\x2C\n  '>>>': 10\x2C\n  '+': 11\x2C\n  '-': 11\x2C\n  '*': 12\x2C\n  '%': 12\x2C\n  '/': 12\x2C\n  '**': 13\x2C\n}\n\n// Enables parenthesis regardless of precedence\nexport const NEEDS_PARENTHESES = 17\n\nexport const EXPRESSIONS_PRECEDENCE = {\n  // Definitions\n  ArrayExpression: 20\x2C\n  TaggedTemplateExpression: 20\x2C\n  ThisExpression: 20\x2C\n  Identifier: 20\x2C\n  PrivateIdentifier: 20\x2C\n  Literal: 18\x2C\n  TemplateLiteral: 20\x2C\n  Super: 20\x2C\n  SequenceExpression: 20\x2C\n  // Operations\n  MemberExpression: 19\x2C\n  ChainExpression: 19\x2C\n  CallExpression: 19\x2C\n  NewExpression: 19\x2C\n  // Other definitions\n  ArrowFunctionExpression: NEEDS_PARENTHESES\x2C\n  ClassExpression: NEEDS_PARENTHESES\x2C\n  FunctionExpression: NEEDS_PARENTHESES\x2C\n  ObjectExpression: NEEDS_PARENTHESES\x2C\n  // Other operations\n  UpdateExpression: 16\x2C\n  UnaryExpression: 15\x2C\n  AwaitExpression: 15\x2C\n  BinaryExpression: 14\x2C\n  LogicalExpression: 13\x2C\n  ConditionalExpression: 4\x2C\n  AssignmentExpression: 3\x2C\n  YieldExpression: 2\x2C\n  RestElement: 1\x2C\n}\n\nfunction formatSequence(state\x2C nodes) {\n  /*\n  Writes into `state` a sequence of `nodes`.\n  */\n  const { generator } = state\n  state.write('(')\n  if (nodes != null && nodes.length > 0) {\n    generator[nodes[0].type](nodes[0]\x2C state)\n    const { length } = nodes\n    for (let i = 1; i < length; i++) {\n      const param = nodes[i]\n      state.write('\x2C ')\n      generator[param.type](param\x2C state)\n    }\n  }\n  state.write(')')\n}\n\nfunction expressionNeedsParenthesis(state\x2C node\x2C parentNode\x2C isRightHand) {\n  const nodePrecedence = state.expressionsPrecedence[node.type]\n  if (nodePrecedence === NEEDS_PARENTHESES) {\n    return true\n  }\n  const parentNodePrecedence = state.expressionsPrecedence[parentNode.type]\n  if (nodePrecedence !== parentNodePrecedence) {\n    // Different node types\n    return (\n      (!isRightHand &&\n        nodePrecedence === 15 &&\n        parentNodePrecedence === 14 &&\n        parentNode.operator === '**') ||\n      nodePrecedence < parentNodePrecedence\n    )\n  }\n  if (nodePrecedence !== 13 && nodePrecedence !== 14) {\n    // Not a `LogicalExpression` or `BinaryExpression`\n    return false\n  }\n  if (node.operator === '**' && parentNode.operator === '**') {\n    // Exponentiation operator has right-to-left associativity\n    return !isRightHand\n  }\n  if (\n    nodePrecedence === 13 &&\n    parentNodePrecedence === 13 &&\n    (node.operator === '??' || parentNode.operator === '??')\n  ) {\n    // Nullish coalescing and boolean operators cannot be combined\n    return true\n  }\n  if (isRightHand) {\n    // Parenthesis are used if both operators have the same precedence\n    return (\n      OPERATOR_PRECEDENCE[node.operator] <=\n      OPERATOR_PRECEDENCE[parentNode.operator]\n    )\n  }\n  return (\n    OPERATOR_PRECEDENCE[node.operator] <\n    OPERATOR_PRECEDENCE[parentNode.operator]\n  )\n}\n\nfunction formatExpression(state\x2C node\x2C parentNode\x2C isRightHand) {\n  /*\n  Writes into `state` the provided `node`\x2C adding parenthesis around if the provided `parentNode` needs it. If `node` is a right-hand argument\x2C the provided `isRightHand` parameter should be `true`.\n  */\n  const { generator } = state\n  if (expressionNeedsParenthesis(state\x2C node\x2C parentNode\x2C isRightHand)) {\n    state.write('(')\n    generator[node.type](node\x2C state)\n    state.write(')')\n  } else {\n    generator[node.type](node\x2C state)\n  }\n}\n\nfunction reindent(state\x2C text\x2C indent\x2C lineEnd) {\n  /*\n  Writes into `state` the `text` string reindented with the provided `indent`.\n  */\n  const lines = text.split('\\n')\n  const end = lines.length - 1\n  state.write(lines[0].trim())\n  if (end > 0) {\n    state.write(lineEnd)\n    for (let i = 1; i < end; i++) {\n      state.write(indent + lines[i].trim() + lineEnd)\n    }\n    state.write(indent + lines[end].trim())\n  }\n}\n\nfunction formatComments(state\x2C comments\x2C indent\x2C lineEnd) {\n  /*\n  Writes into `state` the provided list of `comments`\x2C with the given `indent` and `lineEnd` strings.\n  Line comments will end with `"\\n"` regardless of the value of `lineEnd`.\n  Expects to start on a new unindented line.\n  */\n  const { length } = comments\n  for (let i = 0; i < length; i++) {\n    const comment = comments[i]\n    state.write(indent)\n    if (comment.type[0] === 'L') {\n      // Line comment\n      state.write('// ' + comment.value.trim() + '\\n'\x2C comment)\n    } else {\n      // Block comment\n      state.write('/*')\n      reindent(state\x2C comment.value\x2C indent\x2C lineEnd)\n      state.write('*/' + lineEnd)\n    }\n  }\n}\n\nfunction hasCallExpression(node) {\n  /*\n  Returns `true` if the provided `node` contains a call expression and `false` otherwise.\n  */\n  let currentNode = node\n  while (currentNode != null) {\n    const { type } = currentNode\n    if (type[0] === 'C' && type[1] === 'a') {\n      // Is CallExpression\n      return true\n    } else if (type[0] === 'M' && type[1] === 'e' && type[2] === 'm') {\n      // Is MemberExpression\n      currentNode = currentNode.object\n    } else {\n      return false\n    }\n  }\n}\n\nfunction formatVariableDeclaration(state\x2C node) {\n  /*\n  Writes into `state` a variable declaration.\n  */\n  const { generator } = state\n  const { declarations } = node\n  state.write(node.kind + ' ')\n  const { length } = declarations\n  if (length > 0) {\n    generator.VariableDeclarator(declarations[0]\x2C state)\n    for (let i = 1; i < length; i++) {\n      state.write('\x2C ')\n      generator.VariableDeclarator(declarations[i]\x2C state)\n    }\n  }\n}\n\nlet ForInStatement\x2C\n  FunctionDeclaration\x2C\n  RestElement\x2C\n  BinaryExpression\x2C\n  ArrayExpression\x2C\n  BlockStatement\n\nexport const GENERATOR = {\n  /*\n  Default generator.\n  */\n  Program(node\x2C state) {\n    const indent = state.indent.repeat(state.indentLevel)\n    const { lineEnd\x2C writeComments } = state\n    if (writeComments && node.comments != null) {\n      formatComments(state\x2C node.comments\x2C indent\x2C lineEnd)\n    }\n    const statements = node.body\n    const { length } = statements\n    for (let i = 0; i < length; i++) {\n      const statement = statements[i]\n      if (writeComments && statement.comments != null) {\n        formatComments(state\x2C statement.comments\x2C indent\x2C lineEnd)\n      }\n      state.write(indent)\n      this[statement.type](statement\x2C state)\n      state.write(lineEnd)\n    }\n    if (writeComments && node.trailingComments != null) {\n      formatComments(state\x2C node.trailingComments\x2C indent\x2C lineEnd)\n    }\n  }\x2C\n  BlockStatement: (BlockStatement = function (node\x2C state) {\n    const indent = state.indent.repeat(state.indentLevel++)\n    const { lineEnd\x2C writeComments } = state\n    const statementIndent = indent + state.indent\n    state.write('{')\n    const statements = node.body\n    if (statements != null && statements.length > 0) {\n      state.write(lineEnd)\n      if (writeComments && node.comments != null) {\n        formatComments(state\x2C node.comments\x2C statementIndent\x2C lineEnd)\n      }\n      const { length } = statements\n      for (let i = 0; i < length; i++) {\n        const statement = statements[i]\n        if (writeComments && statement.comments != null) {\n          formatComments(state\x2C statement.comments\x2C statementIndent\x2C lineEnd)\n        }\n        state.write(statementIndent)\n        this[statement.type](statement\x2C state)\n        state.write(lineEnd)\n      }\n      state.write(indent)\n    } else {\n      if (writeComments && node.comments != null) {\n        state.write(lineEnd)\n        formatComments(state\x2C node.comments\x2C statementIndent\x2C lineEnd)\n        state.write(indent)\n      }\n    }\n    if (writeComments && node.trailingComments != null) {\n      formatComments(state\x2C node.trailingComments\x2C statementIndent\x2C lineEnd)\n    }\n    state.write('}')\n    state.indentLevel--\n  })\x2C\n  ClassBody: BlockStatement\x2C\n  StaticBlock(node\x2C state) {\n    state.write('static ')\n    this.BlockStatement(node\x2C state)\n  }\x2C\n  EmptyStatement(node\x2C state) {\n    state.write(';')\n  }\x2C\n  ExpressionStatement(node\x2C state) {\n    const precedence = state.expressionsPrecedence[node.expression.type]\n    if (\n      precedence === NEEDS_PARENTHESES ||\n      (precedence === 3 && node.expression.left.type[0] === 'O')\n    ) {\n      // Should always have parentheses or is an AssignmentExpression to an ObjectPattern\n      state.write('(')\n      this[node.expression.type](node.expression\x2C state)\n      state.write(')')\n    } else {\n      this[node.expression.type](node.expression\x2C state)\n    }\n    state.write(';')\n  }\x2C\n  IfStatement(node\x2C state) {\n    state.write('if (')\n    this[node.test.type](node.test\x2C state)\n    state.write(') ')\n    this[node.consequent.type](node.consequent\x2C state)\n    if (node.alternate != null) {\n      state.write(' else ')\n      this[node.alternate.type](node.alternate\x2C state)\n    }\n  }\x2C\n  LabeledStatement(node\x2C state) {\n    this[node.label.type](node.label\x2C state)\n    state.write(': ')\n    this[node.body.type](node.body\x2C state)\n  }\x2C\n  BreakStatement(node\x2C state) {\n    state.write('break')\n    if (node.label != null) {\n      state.write(' ')\n      this[node.label.type](node.label\x2C state)\n    }\n    state.write(';')\n  }\x2C\n  ContinueStatement(node\x2C state) {\n    state.write('continue')\n    if (node.label != null) {\n      state.write(' ')\n      this[node.label.type](node.label\x2C state)\n    }\n    state.write(';')\n  }\x2C\n  WithStatement(node\x2C state) {\n    state.write('with (')\n    this[node.object.type](node.object\x2C state)\n    state.write(') ')\n    this[node.body.type](node.body\x2C state)\n  }\x2C\n  SwitchStatement(node\x2C state) {\n    const indent = state.indent.repeat(state.indentLevel++)\n    const { lineEnd\x2C writeComments } = state\n    state.indentLevel++\n    const caseIndent = indent + state.indent\n    const statementIndent = caseIndent + state.indent\n    state.write('switch (')\n    this[node.discriminant.type](node.discriminant\x2C state)\n    state.write(') {' + lineEnd)\n    const { cases: occurences } = node\n    const { length: occurencesCount } = occurences\n    for (let i = 0; i < occurencesCount; i++) {\n      const occurence = occurences[i]\n      if (writeComments && occurence.comments != null) {\n        formatComments(state\x2C occurence.comments\x2C caseIndent\x2C lineEnd)\n      }\n      if (occurence.test) {\n        state.write(caseIndent + 'case ')\n        this[occurence.test.type](occurence.test\x2C state)\n        state.write(':' + lineEnd)\n      } else {\n        state.write(caseIndent + 'default:' + lineEnd)\n      }\n      const { consequent } = occurence\n      const { length: consequentCount } = consequent\n      for (let i = 0; i < consequentCount; i++) {\n        const statement = consequent[i]\n        if (writeComments && statement.comments != null) {\n          formatComments(state\x2C statement.comments\x2C statementIndent\x2C lineEnd)\n        }\n        state.write(statementIndent)\n        this[statement.type](statement\x2C state)\n        state.write(lineEnd)\n      }\n    }\n    state.indentLevel -= 2\n    state.write(indent + '}')\n  }\x2C\n  ReturnStatement(node\x2C state) {\n    state.write('return')\n    if (node.argument) {\n      state.write(' ')\n      this[node.argument.type](node.argument\x2C state)\n    }\n    state.write(';')\n  }\x2C\n  ThrowStatement(node\x2C state) {\n    state.write('throw ')\n    this[node.argument.type](node.argument\x2C state)\n    state.write(';')\n  }\x2C\n  TryStatement(node\x2C state) {\n    state.write('try ')\n    this[node.block.type](node.block\x2C state)\n    if (node.handler) {\n      const { handler } = node\n      if (handler.param == null) {\n        state.write(' catch ')\n      } else {\n        state.write(' catch (')\n        this[handler.param.type](handler.param\x2C state)\n        state.write(') ')\n      }\n      this[handler.body.type](handler.body\x2C state)\n    }\n    if (node.finalizer) {\n      state.write(' finally ')\n      this[node.finalizer.type](node.finalizer\x2C state)\n    }\n  }\x2C\n  WhileStatement(node\x2C state) {\n    state.write('while (')\n    this[node.test.type](node.test\x2C state)\n    state.write(') ')\n    this[node.body.type](node.body\x2C state)\n  }\x2C\n  DoWhileStatement(node\x2C state) {\n    state.write('do ')\n    this[node.body.type](node.body\x2C state)\n    state.write(' while (')\n    this[node.test.type](node.test\x2C state)\n    state.write(');')\n  }\x2C\n  ForStatement(node\x2C state) {\n    state.write('for (')\n    if (node.init != null) {\n      const { init } = node\n      if (init.type[0] === 'V') {\n        formatVariableDeclaration(state\x2C init)\n      } else {\n        this[init.type](init\x2C state)\n      }\n    }\n    state.write('; ')\n    if (node.test) {\n      this[node.test.type](node.test\x2C state)\n    }\n    state.write('; ')\n    if (node.update) {\n      this[node.update.type](node.update\x2C state)\n    }\n    state.write(') ')\n    this[node.body.type](node.body\x2C state)\n  }\x2C\n  ForInStatement: (ForInStatement = function (node\x2C state) {\n    state.write(`for ${node.await ? 'await ' : ''}(`)\n    const { left } = node\n    if (left.type[0] === 'V') {\n      formatVariableDeclaration(state\x2C left)\n    } else {\n      this[left.type](left\x2C state)\n    }\n    // Identifying whether node.type is `ForInStatement` or `ForOfStatement`\n    state.write(node.type[3] === 'I' ? ' in ' : ' of ')\n    this[node.right.type](node.right\x2C state)\n    state.write(') ')\n    this[node.body.type](node.body\x2C state)\n  })\x2C\n  ForOfStatement: ForInStatement\x2C\n  DebuggerStatement(node\x2C state) {\n    state.write('debugger;'\x2C node)\n  }\x2C\n  FunctionDeclaration: (FunctionDeclaration = function (node\x2C state) {\n    state.write(\n      (node.async ? 'async ' : '') +\n        (node.generator ? 'function* ' : 'function ') +\n        (node.id ? node.id.name : '')\x2C\n      node\x2C\n    )\n    formatSequence(state\x2C node.params)\n    state.write(' ')\n    this[node.body.type](node.body\x2C state)\n  })\x2C\n  FunctionExpression: FunctionDeclaration\x2C\n  VariableDeclaration(node\x2C state) {\n    formatVariableDeclaration(state\x2C node)\n    state.write(';')\n  }\x2C\n  VariableDeclarator(node\x2C state) {\n    this[node.id.type](node.id\x2C state)\n    if (node.init != null) {\n      state.write(' = ')\n      this[node.init.type](node.init\x2C state)\n    }\n  }\x2C\n  ClassDeclaration(node\x2C state) {\n    state.write('class ' + (node.id ? `${node.id.name} ` : '')\x2C node)\n    if (node.superClass) {\n      state.write('extends ')\n      const { superClass } = node\n      const { type } = superClass\n      const precedence = state.expressionsPrecedence[type]\n      if (\n        (type[0] !== 'C' || type[1] !== 'l' || type[5] !== 'E') &&\n        (precedence === NEEDS_PARENTHESES ||\n          precedence < state.expressionsPrecedence.ClassExpression)\n      ) {\n        // Not a ClassExpression that needs parentheses\n        state.write('(')\n        this[node.superClass.type](superClass\x2C state)\n        state.write(')')\n      } else {\n        this[superClass.type](superClass\x2C state)\n      }\n      state.write(' ')\n    }\n    this.ClassBody(node.body\x2C state)\n  }\x2C\n  ImportDeclaration(node\x2C state) {\n    state.write('import ')\n    const { specifiers\x2C attributes } = node\n    const { length } = specifiers\n    // TODO: Once babili is fixed\x2C put this after condition\n    // https://github.com/babel/babili/issues/430\n    let i = 0\n    if (length > 0) {\n      for (; i < length; ) {\n        if (i > 0) {\n          state.write('\x2C ')\n        }\n        const specifier = specifiers[i]\n        const type = specifier.type[6]\n        if (type === 'D') {\n          // ImportDefaultSpecifier\n          state.write(specifier.local.name\x2C specifier)\n          i++\n        } else if (type === 'N') {\n          // ImportNamespaceSpecifier\n          state.write('* as ' + specifier.local.name\x2C specifier)\n          i++\n        } else {\n          // ImportSpecifier\n          break\n        }\n      }\n      if (i < length) {\n        state.write('{')\n        for (;;) {\n          const specifier = specifiers[i]\n          const { name } = specifier.imported\n          state.write(name\x2C specifier)\n          if (name !== specifier.local.name) {\n            state.write(' as ' + specifier.local.name)\n          }\n          if (++i < length) {\n            state.write('\x2C ')\n          } else {\n            break\n          }\n        }\n        state.write('}')\n      }\n      state.write(' from ')\n    }\n    this.Literal(node.source\x2C state)\n\n    if (attributes && attributes.length > 0) {\n      state.write(' with { ')\n      for (let i = 0; i < attributes.length; i++) {\n        this.ImportAttribute(attributes[i]\x2C state)\n        if (i < attributes.length - 1) state.write('\x2C ')\n      }\n\n      state.write(' }')\n    }\n    state.write(';')\n  }\x2C\n  ImportAttribute(node\x2C state) {\n    this.Identifier(node.key\x2C state)\n    state.write(': ')\n    this.Literal(node.value\x2C state)\n  }\x2C\n  ImportExpression(node\x2C state) {\n    state.write('import(')\n    this[node.source.type](node.source\x2C state)\n    state.write(')')\n  }\x2C\n  ExportDefaultDeclaration(node\x2C state) {\n    state.write('export default ')\n    this[node.declaration.type](node.declaration\x2C state)\n    if (\n      state.expressionsPrecedence[node.declaration.type] != null &&\n      node.declaration.type[0] !== 'F'\n    ) {\n      // All expression nodes except `FunctionExpression`\n      state.write(';')\n    }\n  }\x2C\n  ExportNamedDeclaration(node\x2C state) {\n    state.write('export ')\n    if (node.declaration) {\n      this[node.declaration.type](node.declaration\x2C state)\n    } else {\n      state.write('{')\n      const { specifiers } = node\x2C\n        { length } = specifiers\n      if (length > 0) {\n        for (let i = 0; ; ) {\n          const specifier = specifiers[i]\n          const { name } = specifier.local\n          state.write(name\x2C specifier)\n          if (name !== specifier.exported.name) {\n            state.write(' as ' + specifier.exported.name)\n          }\n          if (++i < length) {\n            state.write('\x2C ')\n          } else {\n            break\n          }\n        }\n      }\n      state.write('}')\n      if (node.source) {\n        state.write(' from ')\n        this.Literal(node.source\x2C state)\n      }\n\n      if (node.attributes && node.attributes.length > 0) {\n        state.write(' with { ')\n        for (let i = 0; i < node.attributes.length; i++) {\n          this.ImportAttribute(node.attributes[i]\x2C state)\n          if (i < node.attributes.length - 1) state.write('\x2C ')\n        }\n\n        state.write(' }')\n      }\n\n      state.write(';')\n    }\n  }\x2C\n  ExportAllDeclaration(node\x2C state) {\n    if (node.exported != null) {\n      state.write('export * as ' + node.exported.name + ' from ')\n    } else {\n      state.write('export * from ')\n    }\n    this.Literal(node.source\x2C state)\n\n    if (node.attributes && node.attributes.length > 0) {\n      state.write(' with { ')\n      for (let i = 0; i < node.attributes.length; i++) {\n        this.ImportAttribute(node.attributes[i]\x2C state)\n        if (i < node.attributes.length - 1) state.write('\x2C ')\n      }\n\n      state.write(' }')\n    }\n\n    state.write(';')\n  }\x2C\n  MethodDefinition(node\x2C state) {\n    if (node.static) {\n      state.write('static ')\n    }\n    const kind = node.kind[0]\n    if (kind === 'g' || kind === 's') {\n      // Getter or setter\n      state.write(node.kind + ' ')\n    }\n    if (node.value.async) {\n      state.write('async ')\n    }\n    if (node.value.generator) {\n      state.write('*')\n    }\n    if (node.computed) {\n      state.write('[')\n      this[node.key.type](node.key\x2C state)\n      state.write(']')\n    } else {\n      this[node.key.type](node.key\x2C state)\n    }\n    formatSequence(state\x2C node.value.params)\n    state.write(' ')\n    this[node.value.body.type](node.value.body\x2C state)\n  }\x2C\n  ClassExpression(node\x2C state) {\n    this.ClassDeclaration(node\x2C state)\n  }\x2C\n  ArrowFunctionExpression(node\x2C 