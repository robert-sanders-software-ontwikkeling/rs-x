script-source,125,file:///Users/robertsanders/projects/rs-x/node_modules/astring/dist/astring.mjs,// Astring is a tiny and fast JavaScript code generator from an ESTree-compliant AST.\n//\n// Astring was written by David Bonnet and released under an MIT license.\n//\n// The Git repository for Astring is available at:\n// https://github.com/davidbonnet/astring.git\n//\n// Please use the GitHub bug tracker to report issues:\n// https://github.com/davidbonnet/astring/issues\n\nconst { stringify } = JSON\n\n/* c8 ignore if */\nif (!String.prototype.repeat) {\n  /* c8 ignore next */\n  throw new Error(\n    'String.prototype.repeat is undefined\x2C see https://github.com/davidbonnet/astring#installation'\x2C\n  )\n}\n\n/* c8 ignore if */\nif (!String.prototype.endsWith) {\n  /* c8 ignore next */\n  throw new Error(\n    'String.prototype.endsWith is undefined\x2C see https://github.com/davidbonnet/astring#installation'\x2C\n  )\n}\n\nconst OPERATOR_PRECEDENCE = {\n  '||': 2\x2C\n  '??': 3\x2C\n  '&&': 4\x2C\n  '|': 5\x2C\n  '^': 6\x2C\n  '&': 7\x2C\n  '==': 8\x2C\n  '!=': 8\x2C\n  '===': 8\x2C\n  '!==': 8\x2C\n  '<': 9\x2C\n  '>': 9\x2C\n  '<=': 9\x2C\n  '>=': 9\x2C\n  in: 9\x2C\n  instanceof: 9\x2C\n  '<<': 10\x2C\n  '>>': 10\x2C\n  '>>>': 10\x2C\n  '+': 11\x2C\n  '-': 11\x2C\n  '*': 12\x2C\n  '%': 12\x2C\n  '/': 12\x2C\n  '**': 13\x2C\n}\n\n// Enables parenthesis regardless of precedence\nexport const NEEDS_PARENTHESES = 17\n\nexport const EXPRESSIONS_PRECEDENCE = {\n  // Definitions\n  ArrayExpression: 20\x2C\n  TaggedTemplateExpression: 20\x2C\n  ThisExpression: 20\x2C\n  Identifier: 20\x2C\n  PrivateIdentifier: 20\x2C\n  Literal: 18\x2C\n  TemplateLiteral: 20\x2C\n  Super: 20\x2C\n  SequenceExpression: 20\x2C\n  // Operations\n  MemberExpression: 19\x2C\n  ChainExpression: 19\x2C\n  CallExpression: 19\x2C\n  NewExpression: 19\x2C\n  // Other definitions\n  ArrowFunctionExpression: NEEDS_PARENTHESES\x2C\n  ClassExpression: NEEDS_PARENTHESES\x2C\n  FunctionExpression: NEEDS_PARENTHESES\x2C\n  ObjectExpression: NEEDS_PARENTHESES\x2C\n  // Other operations\n  UpdateExpression: 16\x2C\n  UnaryExpression: 15\x2C\n  AwaitExpression: 15\x2C\n  BinaryExpression: 14\x2C\n  LogicalExpression: 13\x2C\n  ConditionalExpression: 4\x2C\n  AssignmentExpression: 3\x2C\n  YieldExpression: 2\x2C\n  RestElement: 1\x2C\n}\n\nfunction formatSequence(state\x2C nodes) {\n  /*\n  Writes into `state` a sequence of `nodes`.\n  */\n  const { generator } = state\n  state.write('(')\n  if (nodes != null && nodes.length > 0) {\n    generator[nodes[0].type](nodes[0]\x2C state)\n    const { length } = nodes\n    for (let i = 1; i < length; i++) {\n      const param = nodes[i]\n      state.write('\x2C ')\n      generator[param.type](param\x2C state)\n    }\n  }\n  state.write(')')\n}\n\nfunction expressionNeedsParenthesis(state\x2C node\x2C parentNode\x2C isRightHand) {\n  const nodePrecedence = state.expressionsPrecedence[node.type]\n  if (nodePrecedence === NEEDS_PARENTHESES) {\n    return true\n  }\n  const parentNodePrecedence = state.expressionsPrecedence[parentNode.type]\n  if (nodePrecedence !== parentNodePrecedence) {\n    // Different node types\n    return (\n      (!isRightHand &&\n        nodePrecedence === 15 &&\n        parentNodePrecedence === 14 &&\n        parentNode.operator === '**') ||\n      nodePrecedence < parentNodePrecedence\n    )\n  }\n  if (nodePrecedence !== 13 && nodePrecedence !== 14) {\n    // Not a `LogicalExpression` or `BinaryExpression`\n    return false\n  }\n  if (node.operator === '**' && parentNode.operator === '**') {\n    // Exponentiation operator has right-to-left associativity\n    return !isRightHand\n  }\n  if (\n    nodePrecedence === 13 &&\n    parentNodePrecedence === 13 &&\n    (node.operator === '??' || parentNode.operator === '??')\n  ) {\n    // Nullish coalescing and boolean operators cannot be combined\n    return true\n  }\n  if (isRightHand) {\n    // Parenthesis are used if both operators have the same precedence\n    return (\n      OPERATOR_PRECEDENCE[node.operator] <=\n      OPERATOR_PRECEDENCE[parentNode.operator]\n    )\n  }\n  return (\n    OPERATOR_PRECEDENCE[node.operator] <\n    OPERATOR_PRECEDENCE[parentNode.operator]\n  )\n}\n\nfunction formatExpression(state\x2C node\x2C parentNode\x2C isRightHand) {\n  /*\n  Writes into `state` the provided `node`\x2C adding parenthesis around if the provided `parentNode` needs it. If `node` is a right-hand argument\x2C the provided `isRightHand` parameter should be `true`.\n  */\n  const { generator } = state\n  if (expressionNeedsParenthesis(state\x2C node\x2C parentNode\x2C isRightHand)) {\n    state.write('(')\n    generator[node.type](node\x2C state)\n    state.write(')')\n  } else {\n    generator[node.type](node\x2C state)\n  }\n}\n\nfunction reindent(state\x2C text\x2C indent\x2C lineEnd) {\n  /*\n  Writes into `state` the `text` string reindented with the provided `indent`.\n  */\n  const lines = text.split('\\n')\n  const end = lines.length - 1\n  state.write(lines[0].trim())\n  if (end > 0) {\n    state.write(lineEnd)\n    for (let i = 1; i < end; i++) {\n      state.write(indent + lines[i].trim() + lineEnd)\n    }\n    state.write(indent + lines[end].trim())\n  }\n}\n\nfunction formatComments(state\x2C comments\x2C indent\x2C lineEnd) {\n  /*\n  Writes into `state` the provided list of `comments`\x2C with the given `indent` and `lineEnd` strings.\n  Line comments will end with `"\\n"` regardless of the value of `lineEnd`.\n  Expects to start on a new unindented line.\n  */\n  const { length } = comments\n  for (let i = 0; i < length; i++) {\n    const comment = comments[i]\n    state.write(indent)\n    if (comment.type[0] === 'L') {\n      // Line comment\n      state.write('// ' + comment.value.trim() + '\\n'\x2C comment)\n    } else {\n      // Block comment\n      state.write('/*')\n      reindent(state\x2C comment.value\x2C indent\x2C lineEnd)\n      state.write('*/' + lineEnd)\n    }\n  }\n}\n\nfunction hasCallExpression(node) {\n  /*\n  Returns `true` if the provided `node` contains a call expression and `false` otherwise.\n  */\n  let currentNode = node\n  while (currentNode != null) {\n    const { type } = currentNode\n    if (type[0] === 'C' && type[1] === 'a') {\n      // Is CallExpression\n      return true\n    } else if (type[0] === 'M' && type[1] === 'e' && type[2] === 'm') {\n      // Is MemberExpression\n      currentNode = currentNode.object\n    } else {\n      return false\n    }\n  }\n}\n\nfunction formatVariableDeclaration(state\x2C node) {\n  /*\n  Writes into `state` a variable declaration.\n  */\n  const { generator } = state\n  const { declarations } = node\n  state.write(node.kind + ' ')\n  const { length } = declarations\n  if (length > 0) {\n    generator.VariableDeclarator(declarations[0]\x2C state)\n    for (let i = 1; i < length; i++) {\n      state.write('\x2C ')\n      generator.VariableDeclarator(declarations[i]\x2C state)\n    }\n  }\n}\n\nlet ForInStatement\x2C\n  FunctionDeclaration\x2C\n  RestElement\x2C\n  BinaryExpression\x2C\n  ArrayExpression\x2C\n  BlockStatement\n\nexport const GENERATOR = {\n  /*\n  Default generator.\n  */\n  Program(node\x2C state) {\n    const indent = state.indent.repeat(state.indentLevel)\n    const { lineEnd\x2C writeComments } = state\n    if (writeComments && node.comments != null) {\n      formatComments(state\x2C node.comments\x2C indent\x2C lineEnd)\n    }\n    const statements = node.body\n    const { length } = statements\n    for (let i = 0; i < length; i++) {\n      const statement = statements[i]\n      if (writeComments && statement.comments != null) {\n        formatComments(state\x2C statement.comments\x2C indent\x2C lineEnd)\n      }\n      state.write(indent)\n      this[statement.type](statement\x2C state)\n      state.write(lineEnd)\n    }\n    if (writeComments && node.trailingComments != null) {\n      formatComments(state\x2C node.trailingComments\x2C indent\x2C lineEnd)\n    }\n 