x2C\n        syscall: 'watch'\x2C\n        path: filename\x2C\n        message: err === UV_ENOSPC ?\n          'System limit for number of file watchers reached' : ''\x2C\n      });\n      error.filename = filename;\n      handle.close();\n      throw error;\n    }\n\n    while (!signal?.aborted) {\n      await promise;\n      while (queue.length) {\n        const item = ArrayPrototypeShift(queue);\n        if (item instanceof Error) {\n          throw item;\n        } else {\n          yield item;\n        }\n      }\n      ({ promise\x2C resolve } = PromiseWithResolvers());\n    }\n    if (signal?.aborted) {\n      throw new AbortError(undefined\x2C { cause: signal?.reason });\n    }\n  } finally {\n    handle.close();\n    signal?.removeEventListener('abort'\x2C oncancel);\n  }\n}\n\nmodule.exports = {\n  FSWatcher\x2C\n  StatWatcher\x2C\n  kFSWatchStart\x2C\n  kFSStatWatcherStart\x2C\n  kFSStatWatcherAddOrCleanRef\x2C\n  watch\x2C\n};\n
