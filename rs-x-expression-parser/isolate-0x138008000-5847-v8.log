    fn.name\x2C\n          start\x2C\n          args\x2C\n          histogram));\n    }\n    processComplete(fn.name\x2C start\x2C args\x2C histogram);\n    return result;\n  }\n\n  ObjectDefineProperties(timerified\x2C {\n    length: {\n      __proto__: null\x2C\n      configurable: false\x2C\n      enumerable: true\x2C\n      value: fn.length\x2C\n    }\x2C\n    name: {\n      __proto__: null\x2C\n      configurable: false\x2C\n      enumerable: true\x2C\n      value: `timerified ${fn.name}`\x2C\n    }\x2C\n  });\n\n  return timerified;\n}\n\nmodule.exports = timerify;\n
