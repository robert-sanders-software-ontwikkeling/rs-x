script-source,68,node:internal/modules/package_json_reader,'use strict';\n\nconst {\n  ArrayIsArray\x2C\n  JSONParse\x2C\n  ObjectDefineProperty\x2C\n  RegExpPrototypeExec\x2C\n  SafeMap\x2C\n  StringPrototypeEndsWith\x2C\n  StringPrototypeIndexOf\x2C\n  StringPrototypeLastIndexOf\x2C\n  StringPrototypeSlice\x2C\n} = primordials;\nconst {\n  fileURLToPath\x2C\n  isURL\x2C\n  pathToFileURL\x2C\n  URL\x2C\n} = require('internal/url');\nconst { canParse: URLCanParse } = internalBinding('url');\nconst {\n  codes: {\n    ERR_INVALID_MODULE_SPECIFIER\x2C\n    ERR_MISSING_ARGS\x2C\n    ERR_MODULE_NOT_FOUND\x2C\n  }\x2C\n} = require('internal/errors');\nconst { kEmptyObject } = require('internal/util');\nconst modulesBinding = internalBinding('modules');\nconst path = require('path');\nconst permission = require('internal/process/permission');\nconst { validateString } = require('internal/validators');\nconst internalFsBinding = internalBinding('fs');\n\nconst nearestParentPackageJSONCache = new SafeMap();\n\n/**\n * @typedef {import('typings/internalBinding/modules').DeserializedPackageConfig} DeserializedPackageConfig\n * @typedef {import('typings/internalBinding/modules').PackageConfig} PackageConfig\n * @typedef {import('typings/internalBinding/modules').SerializedPackageConfig} SerializedPackageConfig\n */\n\n/**\n * @param {URL['pathname']} path\n * @param {SerializedPackageConfig} contents\n * @returns {DeserializedPackageConfig}\n */\nfunction deserializePackageJSON(path\x2C contents) {\n  if (contents === undefined) {\n    return {\n      data: {\n        __proto__: null\x2C\n        type: 'none'\x2C // Ignore unknown types for forwards compatibility\n      }\x2C\n      exists: false\x2C\n      path\x2C\n    };\n  }\n\n  const {\n    0: name\x2C\n    1: main\x2C\n    2: type\x2C\n    3: plainImports\x2C\n    4: plainExports\x2C\n    5: optionalFilePath\x2C\n  } = contents;\n\n  const pjsonPath = optionalFilePath ?? path;\n\n  return {\n    data: {\n      __proto__: