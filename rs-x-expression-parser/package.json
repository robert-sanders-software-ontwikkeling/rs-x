{
  "name": "@rs-x/expression-parser",
  "version": "1.0.2",
  "description": "Reactive JavaScript expression parser with observable AST integration for RS-X",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./aot-runtime": {
      "types": "./dist/aot-runtime/index.d.ts",
      "import": "./dist/aot-runtime/index.js",
      "default": "./dist/aot-runtime/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/robert-sanders-software-ontwikkeling/rs-x"
  },
  "homepage": "https://github.com/robert-sanders-software-ontwikkeling/rs-x",
  "bugs": {
    "url": "https://github.com/robert-sanders-software-ontwikkeling/rs-x/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup lib/index.ts lib/aot-runtime/index.ts lib/testing/index.ts --format esm --dts",
    "clean": "rimraf dist",
    "test:expressions:tree": "pnpm jest --runInBand --config ../jest.config.ts ../rs-x-expression-parser/tests/expressions",
    "test:expressions:compiled": "RSX_EXPRESSION_ENGINE_MODE=compiled pnpm jest --runInBand --config ../jest.config.ts ../rs-x-expression-parser/tests/compiled-expression",
    "test:expressions:all-modes": "pnpm run test:expressions:tree && pnpm run test:expressions:compiled",
    "bench:spa-readiness": "node --expose-gc --max-old-space-size=4096 ./scripts/benchmark-spa-readiness.mjs",
    "bench:spa-readiness:median": "node ./scripts/benchmark-spa-readiness-median.mjs",
    "bench:core-concepts-performance": "node --expose-gc --max-old-space-size=4096 ./scripts/benchmark-core-concepts-performance.mjs"
  },
  "peerDependencies": {
    "rxjs": "^7.8.0"
  },
  "peerDependenciesMeta": {
    "rxjs": {
      "optional": false
    }
  },
  "dependencies": {
    "@rs-x/core": "workspace:*",
    "@rs-x/state-manager": "workspace:*",
    "astring": "^1.9.0",
    "meriyah": "^7.1.0"
  },
  "devDependencies": {
    "globals": "^17.4.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "expression-parser",
    "reactive",
    "observable",
    "ast",
    "state-management",
    "rs-x",
    "typescript"
  ]
}
