{
  "name": "rsx-next-example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node ./scripts/generate-static-benchmark-expressions.mjs && rsx build --project tsconfig.json --no-emit --prod && next build",
    "start": "next start"
  },
  "rsx": {
    "build": {
      "preparse": true,
      "preparseFile": "app/rsx-generated/rsx-aot-preparsed.generated.ts",
      "compiled": true,
      "compiledFile": "app/rsx-generated/rsx-aot-compiled.generated.ts",
      "compiledResolvedEvaluator": false
    }
  },
  "dependencies": {
    "next": "^15.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@rs-x/core": "file:../rs-x-core",
    "@rs-x/state-manager": "file:../rs-x-state-manager",
    "@rs-x/expression-parser": "file:../rs-x-expression-parser"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@rs-x/cli": "file:../rs-x-cli",
    "@rs-x/compiler": "file:../rs-x-compiler",
    "@rs-x/typescript-plugin": "file:../rs-x-typescript-plugin"
  }
}
