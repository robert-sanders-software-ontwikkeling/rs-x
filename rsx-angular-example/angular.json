{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "rsx-angular-example": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist/rsx-angular-example",
            "index": "src/index.html",
            "main": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "polyfills": ["src/rsx-generated/rsx-aot-registration.generated.ts"]
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "rsx-angular-example:build"
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "4a47a540-4c1b-42ba-8080-d2f298e001f7"
  }
}
