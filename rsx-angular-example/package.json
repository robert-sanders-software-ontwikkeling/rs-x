{
  "name": "rsx-angular-example",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node ./scripts/generate-static-benchmark-expressions.mjs && rsx build --project tsconfig.json --no-emit --prod",
    "start": "ng serve",
    "build": "ng build"
  },
  "rsx": {
    "build": {
      "preparse": true,
      "preparseFile": "src/rsx-generated/rsx-aot-preparsed.generated.ts",
      "compiled": true,
      "compiledFile": "src/rsx-generated/rsx-aot-compiled.generated.ts",
      "registrationFile": "src/rsx-generated/rsx-aot-registration.generated.ts",
      "compiledResolvedEvaluator": false
    }
  },
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "rxjs": "^7.8.2",
    "zone.js": "^0.15.0",
    "@rs-x/core": "file:../rs-x-core",
    "@rs-x/state-manager": "file:../rs-x-state-manager",
    "@rs-x/expression-parser": "file:../rs-x-expression-parser"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular-builders/custom-webpack": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@rs-x/cli": "file:../rs-x-cli",
    "typescript": "^5.9.3",
    "@rs-x/compiler": "file:../rs-x-compiler",
    "@rs-x/typescript-plugin": "file:../rs-x-typescript-plugin"
  }
}
