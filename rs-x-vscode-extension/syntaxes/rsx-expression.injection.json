{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "scopeName": "rsx.expression.injection",
  "injectionSelector": "L:source.ts -comment -string, L:source.tsx -comment -string, L:source.js -comment -string, L:source.jsx -comment -string, L:source.vue -comment -string, L:text.html.vue -comment -string",
  "patterns": [
    {
      "include": "#rsx-single-quoted-expression"
    },
    {
      "include": "#rsx-double-quoted-expression"
    },
    {
      "include": "#rsx-template-literal-expression"
    }
  ],
  "repository": {
    "rsx-single-quoted-expression": {
      "name": "meta.function-call.rsx",
      "begin": "\\brsx(?:\\s*<(?:[^<>]|<[^<>]*>)+>)?\\s*\\(\\s*(')",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.ts"
        }
      },
      "end": "(?<!\\\\)'",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.ts"
        }
      },
      "contentName": "meta.embedded.inline.rsx",
      "patterns": [
        {
          "include": "#rsx-expression"
        }
      ]
    },
    "rsx-double-quoted-expression": {
      "name": "meta.function-call.rsx",
      "begin": "\\brsx(?:\\s*<(?:[^<>]|<[^<>]*>)+>)?\\s*\\(\\s*(\")",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.ts"
        }
      },
      "end": "(?<!\\\\)\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.ts"
        }
      },
      "contentName": "meta.embedded.inline.rsx",
      "patterns": [
        {
          "include": "#rsx-expression"
        }
      ]
    },
    "rsx-template-literal-expression": {
      "name": "meta.function-call.rsx",
      "begin": "\\brsx(?:\\s*<(?:[^<>]|<[^<>]*>)+>)?\\s*\\(\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.string.begin.ts"
        }
      },
      "end": "(?<!\\\\)`",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.ts"
        }
      },
      "contentName": "meta.embedded.inline.rsx",
      "patterns": [
        {
          "include": "#rsx-expression"
        }
      ]
    },
    "rsx-expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#properties"
        },
        {
          "include": "#functions"
        },
        {
          "include": "#identifiers"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.ts",
          "match": "//.*$"
        },
        {
          "name": "comment.block.ts",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.ts",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ts",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ts",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.ts",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.template.ts",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.ts",
              "match": "\\\\."
            },
            {
              "name": "punctuation.definition.template-expression.begin.ts",
              "match": "\\$\\{"
            },
            {
              "name": "punctuation.definition.template-expression.end.ts",
              "match": "\\}"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.ts",
          "match": "\\b(?:0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?n?)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "constant.language.boolean.ts",
          "match": "\\b(?:true|false|null|undefined|NaN|Infinity)\\b"
        },
        {
          "name": "keyword.operator.expression.ts",
          "match": "\\b(?:as|await|delete|in|instanceof|new|satisfies|typeof|void|yield)\\b"
        },
        {
          "name": "variable.language.this.ts",
          "match": "\\bthis\\b"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "name": "variable.other.property.ts",
          "match": "(?<=\\.)\\s*([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": {
              "name": "variable.other.property.ts"
            }
          }
        },
        {
          "name": "variable.other.property.ts",
          "match": "\\b([A-Za-z_$][\\w$]*)(?=\\s*:)",
          "captures": {
            "1": {
              "name": "variable.other.property.ts"
            }
          }
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.ts",
          "match": "\\b([A-Za-z_$][\\w$]*)(?=\\s*\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.property.rsx",
          "match": "\\b[A-Za-z_$][\\w$]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "meta.rsx.symbol",
          "match": "=>|===|!==|==|!=|<=|>=|&&|\\|\\||\\?\\?|\\?\\.|\\*\\*|[+\\-*/%<>=!&|^~?:]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.ts",
          "match": ","
        },
        {
          "name": "punctuation.terminator.statement.ts",
          "match": ";"
        },
        {
          "name": "punctuation.accessor.ts",
          "match": "\\."
        },
        {
          "name": "punctuation.definition.bracket.ts",
          "match": "[()\\[\\]{}]"
        }
      ]
    }
  }
}
