{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*",
    "app/**/*",
    "providers/**/*",
    "types/**/*.d.ts",
    "../types/declarations.d.ts"
  ],
  "exclude": ["node_modules", "dist", "lib/testing", ".next"]
}
