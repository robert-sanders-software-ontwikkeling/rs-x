{
  "name": "@rs-x/typescript-plugin",
  "version": "2.0.1",
  "description": "TypeScript server plugin that adds RS-X IntelliSense inside expression strings",
  "type": "commonjs",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup lib/index.ts --format cjs",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@rs-x/compiler": "workspace:*"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "typescript",
    "tsserver",
    "plugin",
    "rs-x"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/robert-sanders-software-ontwikkeling/rs-x"
  },
  "homepage": "https://github.com/robert-sanders-software-ontwikkeling/rs-x",
  "bugs": {
    "url": "https://github.com/robert-sanders-software-ontwikkeling/rs-x/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
